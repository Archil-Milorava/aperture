# Copy this file to .env and fill in real values.
NODE_ENV=development
PORT=3000

# Database (PostgreSQL) — these must match docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=aperture
DB_PASSWORD=change_me
DB_NAME=aperture

# Auth (JWT)
JWT_SECRET=change_me_min_16_chars
JWT_EXPIRES_IN=3600

# AWS / S3 — defaults target LocalStack (fake AWS) for local dev.
# For real AWS: remove AWS_S3_ENDPOINT and use real credentials.
AWS_REGION=us-east-1
AWS_S3_BUCKET=aperture-uploads
AWS_S3_ENDPOINT=http://localstack:4566
AWS_S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_S3_URL_EXPIRES=900
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Redis (caching, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (event streaming)
KAFKA_BROKER=localhost:9092
